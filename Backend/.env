# App
PROJECT_NAME=Private Clinic Management API
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:5432/clinic_db

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# SMTP (disabled for local dev)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Private Clinic <noreply@clinic.local>
SMTP_USE_TLS=False
